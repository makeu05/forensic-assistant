dans un dossier de type << mandat.type_label | tex >> (priorit\'e << mandat.priority | tex >>).

\begin{itemize}
\item << pvs | length >> proc\`es-verbal(aux) d'audition analys\'e(s).
\item << incoherences | length >> incoh\'erence(s) d\'etect\'ee(s), dont << high_count >> de s\'ev\'erit\'e haute.
