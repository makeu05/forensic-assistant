# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit it, never share it.
# A variable already set in your shell wins over this file.

# --- Security ---------------------------------------------------------------------------------
# At least 32 characters. Keeps users logged in across API restarts.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where the web app is reached. Used to build the links in e-mails (account activation, etc.)
APP_BASE_URL=http://localhost:5173

# --- E-mail through Brevo (https://app.brevo.com) ---------------------------------------------
# Leave SMTP_HOST empty to keep e-mails local: they are then only written to output/outbox/.
# In Brevo, open the top-right menu, then "SMTP & API", then the "SMTP" tab.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# The "Login" shown on that SMTP tab (looks like 1a2b3c@smtp-brevo.com).
SMTP_USER=

# The SMTP key you generate on that tab (starts with xsmtpsib-). It is NOT your Brevo account password.
SMTP_PASSWORD=

# The sender address. It must be a sender you verified in Brevo
# (Senders, domains & dedicated IPs, then Senders), otherwise Brevo refuses the message.
SMTP_FROM=

# Optional safety net. Addresses on reserved domains (.example, .test, example.com...) are NEVER sent for real,
# whatever you set here, so the demo experts cannot cause bounces. To also restrict real sending to a few
# recipients while you test, list them here (comma-separated addresses or domains). Empty means no restriction.
SMTP_ALLOWED=
