# Copy to `.env` ON THE SERVER and fill it in. Never commit that file, never send it by e-mail or chat.
# Generate each secret with:  openssl rand -hex 32     (hex only: it goes into a database URL)

# The public address of the app. Use ":80" to test over plain HTTP on the server's IP before you have a domain.
DOMAIN=belva.work.gd

POSTGRES_USER=locard
POSTGRES_DB=locard
POSTGRES_PASSWORD=

# At least 32 characters. Keep it the same across restarts, otherwise everyone is logged out.
JWT_SECRET=

# Links in e-mails (account activation) point here. Must match DOMAIN, with https:// (or http://IP for a test).
APP_BASE_URL=https://belva.work.gd

# E-mail through Brevo (see .env.example for where to find these)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@belva.work.gd
