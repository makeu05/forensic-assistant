# DOMAIN comes from the environment: belva.work.gd for HTTPS, or ":80" to try without a domain (plain HTTP).
{$DOMAIN:localhost} {
	encode zstd gzip

	# The API sets its own security headers; Caddy only forwards the request (and adds X-Forwarded-For).
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			# 'unsafe-inline' for styles only: the UI library injects its styles at runtime. Scripts stay 'self'.
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
